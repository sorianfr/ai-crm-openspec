# Database (SQLite file path; created on first connection or when migrations run)
DATABASE_URL=sqlite:///./app.db

# JWT auth (set JWT_SECRET in production; use strong secret)
# JWT_SECRET=
# JWT_EXPIRATION_MINUTES=60

# Session (web login; set SESSION_SECRET in production)
# SESSION_SECRET=
# SESSION_MAX_AGE=28800

# Optional: debug mode
# DEBUG=false
